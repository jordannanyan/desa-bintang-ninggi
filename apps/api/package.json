{
  "name": "@desa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:isi-profil": "tsx prisma/isi-profil.ts",
    "db:cek": "tsx prisma/cek-tabel.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@desa/shared": "*",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.6.0",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "_catatan_optionalDependencies": "Biner sharp untuk Linux dideklarasikan eksplisit agar tercatat di package-lock.json. Lockfile dibuat di Windows dan npm hanya mencatat biner platform tempat instalasi berjalan (npm/cli#4828), sehingga `npm ci` di VPS Linux tidak memasangnya dan `import sharp` menggagalkan API saat start. Dilewati sendiri pada instalasi di Windows karena paketnya menandai os=linux.",
  "optionalDependencies": {
    "@img/sharp-linux-x64": "^0.33.5",
    "@img/sharp-libvips-linux-x64": "^1.0.4",
    "@img/sharp-linux-arm64": "^0.33.5",
    "@img/sharp-libvips-linux-arm64": "^1.0.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
