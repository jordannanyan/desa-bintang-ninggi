# Salin menjadi apps/api/.env lalu isi nilainya.

NODE_ENV=development
PORT=4000

# MySQL
DATABASE_URL="mysql://root:@localhost:3306/desa_bintang_ninggi"

# Rahasia JWT — minimal 32 karakter, berbeda satu sama lain.
# Bangkitkan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Kunci enkripsi NIK & nomor KK — TEPAT 64 karakter hex (32 byte).
# Bangkitkan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JANGAN pernah diganti setelah ada data — semua NIK tersimpan tidak akan bisa dibaca lagi.
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

WEB_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Password admin pertama, dipakai sekali saat `npm run db:seed`.
ADMIN_PASSWORD_AWAL=
