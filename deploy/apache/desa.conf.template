# ─────────────────────────────────────────────────────────────
# Virtual host Apache untuk Website Desa Bintang Ninggi I
#
# Berkas ini adalah TEMPLATE. Jangan diedit langsung di server —
# jalankan `sudo bash deploy/setup-vps.sh` yang akan mengisi
# {{DOMAIN}}, {{APP_DIR}}, dan {{API_PORT}} lalu menaruh hasilnya di
# /etc/apache2/sites-available/desa.conf
#
# Susunannya:
#   Apache menyajikan hasil build React sebagai berkas statis, dan
#   meneruskan /api serta /uploads ke Express. Karena keduanya lewat
#   satu domain, tidak ada masalah CORS maupun cookie lintas situs.
#
# VPS ini dipakai bersama situs lain. Seluruh aturan di bawah berada
# di dalam <VirtualHost> dengan ServerName tertentu, sehingga hanya
# berlaku untuk domain desa dan tidak menyentuh situs tetangga.
# ─────────────────────────────────────────────────────────────

<VirtualHost *:80>
    ServerName {{DOMAIN}}
    ServerAdmin webmaster@{{DOMAIN}}

    DocumentRoot {{APP_DIR}}/apps/web/dist

    # ── Paksa HTTPS, tapi hanya bila sertifikatnya benar-benar sudah ada ──
    # <IfFile> membuat blok ini mati sendiri pada pemasangan baru yang belum
    # punya sertifikat. Tanpa penjaga itu, situs akan mengalihkan ke HTTPS
    # yang belum tersedia dan tidak bisa dibuka sama sekali.
    #
    # RewriteCond %{HTTPS} mencegah pengalihan berulang: certbot membuat vhost
    # HTTPS dengan menyalin berkas ini, dan salinannya ikut memuat aturan ini.
    <IfFile /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem>
        RewriteEngine On
        RewriteCond %{HTTPS} !=on
        RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [END,NE,R=permanent]
    </IfFile>

    <Directory {{APP_DIR}}/apps/web/dist>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted

        # React Router memakai rute sisi klien: /profil, /layanan, dan
        # seterusnya tidak punya berkas fisik. Semua permintaan yang tidak
        # cocok dengan berkas nyata dikembalikan ke index.html agar
        # aplikasi yang menangani rutenya.
        RewriteEngine On
        RewriteCond %{REQUEST_FILENAME} -f [OR]
        RewriteCond %{REQUEST_FILENAME} -d
        RewriteRule ^ - [L]
        RewriteRule ^ index.html [L]
    </Directory>

    # ── Teruskan API ke Express ──
    ProxyPreserveHost On
    ProxyPass        /api  http://127.0.0.1:{{API_PORT}}/api  retry=0
    ProxyPassReverse /api  http://127.0.0.1:{{API_PORT}}/api

    # Berkas unggahan (lampiran surat, foto pengaduan, bukti bayar)
    ProxyPass        /uploads  http://127.0.0.1:{{API_PORT}}/uploads  retry=0
    ProxyPassReverse /uploads  http://127.0.0.1:{{API_PORT}}/uploads

    # Alamat IP asli pengunjung diteruskan ke Express, supaya audit log
    # dan rate limit tidak mencatat 127.0.0.1 untuk semua orang.
    #
    # Skema dibaca dari permintaan yang sedang berjalan, bukan ditulis mati.
    # Certbot membuat vhost HTTPS dengan menyalin berkas ini; kalau nilainya
    # dipaku "http", vhost HTTPS hasil salinan itu akan berbohong kepada
    # Express bahwa pengunjungnya datang lewat HTTP.
    RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}

    # ── Cache ──
    # Berkas hasil build Vite bernama unik per rilis (index-a1b2c3.js),
    # jadi aman di-cache lama. index.html tidak boleh di-cache, agar
    # pengunjung langsung mendapat versi terbaru setelah deploy.
    <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # ── Kompresi ──
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml

    # ── Pengamanan dasar ──
    # Catatan: ServerTokens TIDAK bisa ditaruh di sini — direktif itu hanya
    # berlaku di tingkat server (/etc/apache2/conf-enabled/security.conf), dan
    # menaruhnya di dalam <VirtualHost> membuat Apache gagal start. Karena VPS
    # ini dipakai bersama, pengaturan tingkat server memang tidak kita sentuh.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS hanya dikirim lewat koneksi HTTPS (env=HTTPS diisi mod_ssl).
    # Mengirimnya lewat HTTP tidak ada gunanya dan diabaikan peramban.
    # 180 hari, tanpa includeSubDomains: janji ini sulit ditarik kembali,
    # jadi cakupannya dibatasi pada nama host ini saja.
    Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS

    ErrorLog  ${APACHE_LOG_DIR}/desa-error.log
    CustomLog ${APACHE_LOG_DIR}/desa-access.log combined
</VirtualHost>
