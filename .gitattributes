# Normalisasi akhir baris.
#
# Tanpa berkas ini, Git di Windows mengubah akhir baris menjadi CRLF, dan
# skrip shell yang di-pull di VPS akan gagal dengan pesan membingungkan
# "bad interpreter: /usr/bin/env bash^M". Karena itu semua berkas yang
# dieksekusi atau dibaca Linux dipaksa LF.

* text=auto eol=lf

# Wajib LF — dieksekusi langsung oleh Linux
*.sh          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
*.template    text eol=lf
*.sql         text eol=lf

# Biner — jangan diutak-atik
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.pdf         binary
*.woff2       binary
*.ico         binary
